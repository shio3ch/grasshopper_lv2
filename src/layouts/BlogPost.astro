---
import BaseLayout from "./BaseLayout.astro";
import "../styles/blog-post.css";
import { formatDate, toISODateString } from "../utils/formatDate";
import { getTagPath } from "../utils/tagUrl";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  author?: string;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  tags = [],
  author = "grasshopper",
} = Astro.props;
---

<BaseLayout title={title} description={description}>
  <article>
    <header class="article-header">
      <h1 class="article-header__title">{title}</h1>
      <p class="article-header__meta">
        <time datetime={toISODateString(pubDate)}>{formatDate(pubDate)}</time>
        {
          updatedDate && (
            <span class="article-header__updated">
              更新:{" "}
              <time datetime={toISODateString(updatedDate)}>
                {formatDate(updatedDate)}
              </time>
            </span>
          )
        }
        <span class="article-header__author">by {author}</span>
      </p>
      {
        tags.length > 0 && (
          <div class="article-header__tags">
            {tags.map((tag) => (
              <a href={getTagPath(tag)} class="article-header__tag">#{tag}</a>
            ))}
          </div>
        )
      }
    </header>

    <div class="prose">
      <slot />
    </div>

    <div class="article-footer">
      <a href="/">&larr; 記事一覧に戻る</a>
    </div>
  </article>
</BaseLayout>
