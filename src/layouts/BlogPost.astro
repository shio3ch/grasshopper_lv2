---
import BaseLayout from "./BaseLayout.astro";
import { formatDate, toISODateString } from "../utils/formatDate";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  author?: string;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  tags = [],
  author = "grasshopper",
} = Astro.props;
---

<BaseLayout title={title} description={description}>
  <article>
    <header class="article-header">
      <h1 class="article-header__title">{title}</h1>
      <p class="article-header__meta">
        <time datetime={toISODateString(pubDate)}>{formatDate(pubDate)}</time>
        {
          updatedDate && (
            <span style="margin-left:1rem;">
              更新:{" "}
              <time datetime={toISODateString(updatedDate)}>
                {formatDate(updatedDate)}
              </time>
            </span>
          )
        }
        <span style="margin-left:1rem;">by {author}</span>
      </p>
      {
        tags.length > 0 && (
          <div class="article-header__tags">
            {tags.map((tag) => (
              <span class="article-header__tag">#{tag}</span>
            ))}
          </div>
        )
      }
    </header>

    <div class="prose" style="line-height:1.8;">
      <slot />
    </div>

    <div class="article-footer">
      <a href="/">&larr; 記事一覧に戻る</a>
    </div>
  </article>
</BaseLayout>

<style>
  .article-header {
    margin-bottom: 2rem;
  }

  .article-header__title {
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 0.75rem;
    color: var(--color-text);
  }

  .article-header__meta {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    margin-bottom: 0.5rem;
  }

  .article-header__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .article-header__tag {
    background: var(--color-tag-bg);
    color: var(--color-tag-text);
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
    font-size: 0.8rem;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .article-footer {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
    transition: border-color 0.2s ease;
  }
</style>

<style is:global>
  .prose h2 {
    font-size: 1.5rem;
    font-weight: 700;
    margin: 2rem 0 1rem;
    color: var(--color-text);
  }

  .prose h3 {
    font-size: 1.25rem;
    font-weight: 700;
    margin: 1.5rem 0 0.75rem;
    color: var(--color-text);
  }

  .prose p {
    margin-bottom: 1rem;
  }

  .prose ul,
  .prose ol {
    margin: 1rem 0 1rem 1.5rem;
  }

  .prose li {
    margin-bottom: 0.25rem;
  }

  .prose pre {
    background: #1e1e1e;
    color: #d4d4d4;
    padding: 1rem 1.25rem;
    border-radius: 0.5rem;
    overflow-x: auto;
    margin: 1rem 0;
    font-size: 0.9rem;
  }

  .prose code:not(pre code) {
    background: var(--color-code-inline-bg);
    padding: 0.15rem 0.4rem;
    border-radius: 0.25rem;
    font-size: 0.9em;
    transition: background-color 0.2s ease;
  }

  .prose a {
    color: var(--color-link);
  }

  .prose strong {
    font-weight: 700;
  }
</style>
