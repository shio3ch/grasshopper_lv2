---
import { formatDate, toISODateString } from "../utils/formatDate";
import { getTagPath } from "../utils/tagUrl";
import "../styles/post-card.css";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags?: string[];
  slug: string;
  variant?: "featured" | "compact";
}

const { title, description, pubDate, tags = [], slug, variant } = Astro.props;
const cardClass = ["post-card", variant && `post-card--${variant}`].filter(Boolean).join(" ");
---

<article class={cardClass}>
  <h2 class="post-card__title">
    <a href={`/blog/${slug}/`} class="post-card__title-link">{title}</a>
  </h2>
  <p class="post-card__meta">
    <time datetime={toISODateString(pubDate)}>{formatDate(pubDate)}</time>
  </p>
  <p class="post-card__description">{description}</p>
  {
    tags.length > 0 && (
      <div class="post-card__tags">
        {tags.map((tag) => (
          <a href={getTagPath(tag)} class="post-card__tag">#{tag}</a>
        ))}
      </div>
    )
  }
</article>
